// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  info  UserInfo?
  meals Meal[]

  @@map("users")
}

// One-to-one with User, populated by Intake.tsx (POST /survey)
model UserInfo {
  userId            String @id @map("user_id")
  age               Int
  sex               String
  heightFeet        Int    @map("height_feet")
  heightInches      Int    @map("height_inches")
  weight            Float
  activityType      String @map("activity_type")
  activityFrequency String @map("activity_frequency")
  fitnessGoal       String @map("fitness_goal")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_info")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  mealType MealType @map("meal_type")
  date     DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@map("meals")
}

model MealItem {
  id       String @id @default(uuid())
  mealId   String @map("meal_id")
  foodName String @map("food_name")
  portion  String
  calories Float
  protein  Float
  carbs    Float
  fat      Float
  date     DateTime @default(now())

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("meal_items")
}