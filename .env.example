DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/nutribloom?schema=public"

# USDA FoodData Central API key. Get a free one at https://fdc.nal.usda.gov/api-key-signup
# If left unset, the food-search route falls back to USDA's public DEMO_KEY
# (only 30 requests/hour, 50/day) so it still works out of the box for local dev.
USDA_FDC_API_KEY="DEMO_KEY" 